+  const status = deriveRoomStatus({
+    maintenanceStatus: room.maintenanceStatus,
+    hasActiveBooking: !!activeBooking,
+    hasReservedBooking: !!upcomingReservation,
+  });
+
+  return db.room.update({ where: { id: roomId }, data: { status } });
+}
