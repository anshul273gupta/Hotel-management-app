# ── Database (PostgreSQL — e.g. Neon or Supabase) ────────────────────────────
# Pooled connection, used by the app at runtime. Contains "-pooler" on Neon.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by `prisma migrate` (pooled connections can't run DDL).
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Optional ─────────────────────────────────────────────────────────────────
# Public base URL. Used for room QR code links and for the click-through target
# of push notifications. Set this to your real site URL in production.
APP_BASE_URL="http://localhost:3000"

# Shown on the guest QR page ("Call Reception") and in WhatsApp messages.
# These are read in the browser, so they MUST keep the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_HOTEL_NAME="Hotel Agrawal Inn"
NEXT_PUBLIC_HOTEL_PHONE="7342551411"

# Guest WiFi shown on the room QR page. Both are public by nature - they are
# printed on the card in every room - so the NEXT_PUBLIC_ prefix is fine.
# Leave the password blank to hide the WiFi card entirely.
NEXT_PUBLIC_WIFI_SSID="Hotel Agrawal Inn"
NEXT_PUBLIC_WIFI_PASSWORD="A9406851411"

# Lets Vercel Cron trigger the automatic check-out / payment-reminder sweep.
# Any long random string; must match the value set in Vercel.
CRON_SECRET="change-me-to-a-long-random-string"

# ── Push notifications (optional) ────────────────────────────────────────────
# All seven NEXT_PUBLIC_ values come from Firebase Console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# The VAPID key is under Cloud Messaging → Web Push certificates → Key pair.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
#
# Server credentials for sending push. Firebase Console → Project settings →
# Service accounts → Generate new private key. Paste the whole JSON here, or
# base64-encode it first to avoid newline problems in dashboard fields:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
# FIREBASE_SERVICE_ACCOUNT_JSON=""
#
# Local development alternative — a path to that same JSON file. Not usable on
# Vercel, which has no writable disk.
# FIREBASE_SERVICE_ACCOUNT_PATH="firebase/service-account.json"
